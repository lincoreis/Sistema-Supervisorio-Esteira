                text: "-.-"
                size_hint_x: None
                width: dp(80)
                halign: "right"
                valign: "middle"
                text_size: self.size
            Label:
                text: "ºC"
                size_hint_x: None
                width: dp(40)
                halign: "left"
                valign: "middle"
                text_size: self.size

            # 3) Temperatura no enrolamento S
            Label:
                text: "Temperatura no enrolamento S"
                size_hint_x: None
                width: dp(260)
                halign: "left"
                valign: "middle"
                text_size: self.size
            Label:
                id: tempS
                text: "-.-"
                size_hint_x: None
                width: dp(80)
                halign: "right"
                valign: "middle"
                text_size: self.size
            Label:
                text: "ºC"
                size_hint_x: None
                width: dp(40)
                halign: "left"
                valign: "middle"
                text_size: self.size

            # 4) Temperatura no enrolamento T
            Label:
                text: "Temperatura no enrolamento T"
                size_hint_x: None
                width: dp(260)
                halign: "left"
                valign: "middle"
                text_size: self.size
            Label:
                id: tempT
                text: "-.-"
                size_hint_x: None
