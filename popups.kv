            CheckBox:
                id:checkCorrenteR
                group: 'select_group'
                on_active: app.root.updateSelectedGrandeza('CorrenteR') if app.root is not None else None
            Label:
                text: "Corrente R (A)"
            CheckBox:
                id:checkCorrenteS
                group: 'select_group'
