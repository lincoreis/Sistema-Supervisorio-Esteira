<TemperaturaPopup>:
    title: "Medidas de temperatura"
    size_hint: 0.6, 0.5

    BoxLayout:
        orientation: "vertical"
        padding: dp(18)
        spacing: dp(10)

        canvas.before:
            Color:
                rgba: 0.1, 0.7, 0.8, 1
            Rectangle:
                pos: self.x, self.top - dp(2)
                size: self.width, dp(2)

        GridLayout:
            cols: 3
            row_default_height: dp(30)
            row_force_default: True
            spacing: dp(8)

            # 1) Temperatura da carcaça do motor
            Label:
                text: "Temperatura na carcaça do motor"
                size_hint_x: None
                width: dp(260)
                halign: "left"
                valign: "middle"
                text_size: self.size
            Label:
                id: TempCarc
                text: "-.-"
                size_hint_x: None
                width: dp(80)
                halign: "right"
                valign: "middle"
                text_size: self.size
            Label:
                text: "ºC"
                size_hint_x: None
                width: dp(40)
                halign: "left"
                valign: "middle"
                text_size: self.size

            # 2) Temperatura no enrolamento R
            Label:
