#:kivy 1.11.1

<ModbusPopup>:
    title: "Configurações MODBUS"
    size_hint_y: None
    size_hint_x: 0.4
    height: 200
    BoxLayout:
        id: layout
        orientation: 'vertical'
        GridLayout:
            cols: 2
            rows: 2
            Label:
                text: "IP"
                font_size: 14
            TextInput:
                id: txt_ip
                text: "127.0.0.1"
                font_size: 14
                halign: 'center'
                valign: 'middle'
            Label:
                text: "Porta"
                font_size: 14
            TextInput:
                id: txt_port
                text: "502"
                font_size: 14
                halign: 'center'
                valign: 'middle'
        BoxLayout:
            orientation:'horizontal'
            Button:
                size_hint_y: None
                height: 40
                text: "Conectar"
                on_release:
                    root.clearInfo() 
                    app.root.startDataRead(txt_ip.text, int(txt_port.text))
            Button:
                size_hint_y: None
                height: 40
                text: "Fechar"
                on_release:
                    root.dismiss()
                    root.clearInfo()

<ScanPopup>:
    title: "Configuração ScanTime"
    size_hint_y: None
    size_hint_x: 0.4
    height: 150
    BoxLayout:
        id: layout
        orientation: 'vertical'
        GridLayout:
            cols: 2
            rows: 1
            Label:
                text: "ScanTime [ms]"
                font_size: 14
            TextInput:
                id: txt_st
                font_size: 14
                halign: 'center'
                valign: 'middle'
        BoxLayout:
            orientation:'horizontal'
            Button:
                size_hint_y: None
                height: 40
                text: "Configurar"
                on_release: 
                    app.root._scan_time = int(txt_st.text)
            Button:
                size_hint_y: None
                height: 40
                text: "Fechar"
                on_release:
                    root.dismiss()

<DataGraphPopup>:
    title: "Gráfico em tempo real"
    BoxLayout:
        orientation: 'vertical'
        TimeSeriesGraph:
            id: graph
            xlabel: 'Horário'
            ylabel: 'Medida'
            background_color: 0.5,0.5,0.5,0.5
            x_ticks_minor: 1
            x_ticks_major: 5
            y_ticks_major: 50
            y_grid_label: True
            x_grid_label: True
            padding: 5
            x_grid: True
            y_grid: True
            xmin: 0
            xmax: 20
            ymin:0
            ymax: 100
        BoxLayout:
            orientation: 'horizontal'
            size_hint: (1,0.05)
            BoxLayout:
                orientation: 'horizontal'
                size_hint: (0.5,1)
                BoxLayout:
                    orientation: 'vertical'
                    size_hint: (0.3,1)
                    Button:
                        text: 'Seleção de grandeza'
                        on_release: app.root._selectData.open()
                Label:
                    text: "Número de pontos do gráfico"
                    size_hint: (0.3,1)
                LabeledCheckBoxDataGraph:
                    id: mp20
                    on_kv_post: 
                        self.ids.label.text = '20'
                        self.ids.checkbox.group = 'cb_group'
                        self.ids.checkbox.active = True
                LabeledCheckBoxDataGraph:
                    id: mp50
                    on_kv_post: 
                        self.ids.label.text = '50'
                        self.ids.checkbox.group = 'cb_group'
                LabeledCheckBoxDataGraph:
                    id: mp100
                    on_kv_post: 
                        self.ids.label.text = '100'
                        self.ids.checkbox.group = 'cb_group'
                Button:
                    text: "Fechar"
                    size_hint: (0.2,1)
                    on_release: root.dismiss()

<LabeledCheckBoxDataGraph>:
    orientation: 'horizontal'
    size_hint: (0.1,1)
    CheckBox:
        id: checkbox
        on_active: app.root._graph.ids.graph.setMaxPoints(int(label.text),0) if app.root is not None else None
    Label:
        id: label

<HistGraphPopup>:
    title: "Histórico de medições da planta"
    BoxLayout:
        orientation: 'vertical'

        TimeSeriesGraph:
            id: graph
            xlabel: 'Horário'
            ylabel: 'Medida'
            background_color: 0.5,0.5,0.5,0.5
            x_ticks_minor: 1
            x_ticks_major: 5
            y_ticks_major: 50
            y_grid_label: True
            x_grid_label: True
            padding: 5
            x_grid: True
            y_grid: True
            xmin: 0
            ymin: 0
            ymax: 500

        # --- área onde ficavam as checkboxes de sensores ---
        BoxLayout:
            orientation: 'horizontal'
            size_hint: (1,0.15)
            padding: 5
            spacing: 5

            Label:
                text: 'Grandeza:'
                size_hint_x: 0.2
                halign: 'right'
                valign: 'middle'
                text_size: self.size

            Spinner:
                id: spn_grandeza
                size_hint_x: 0.5
                text: ''
                values: []
                # quando muda o texto -> troca de grandeza e atualiza o gráfico
                on_text: app.root.updateSelectedGrandezaHist(self.text) if app.root is not None else None

        # --- barra de timestamps: fica praticamente igual ---
        BoxLayout:
            orientation: 'horizontal'
            size_hint: (1,0.15)

            Label:
                text: 'Timestamp inicial \r\n [size=12] (DD/MM/AAAA HH:MM:SS)[/size]'
                halign: 'center'
                markup: True
            TextInput:
                id: txt_init_time
                size_hint: (1,0.8)
                halign: 'center'
                valign: 'middle'
                multiline: False

            Label:
                text: 'Timestamp final \r\n [size=12] (DD/MM/AAAA HH:MM:SS)[/size]'
                halign: 'center'
                markup: True
            TextInput:
                id: txt_final_time
                size_hint: (1,0.8)
                halign: 'center'
                valign: 'middle'
                multiline: False

            Button:
                text: "Fechar"
                size_hint: (1,0.8)
                on_release: root.dismiss()


<LabeledCheckBoxHistGraph>:
    orientation: 'horizontal'
    size_hint: (0.05,1)
    CheckBox:
        id: checkbox
        on_active: app.root.getDataDB()
    Label:
        id: label
        font_size: 12 
        bold: True


<PidPopup>:
    title:"Configuração e dados do PID"
    size_hint_y: None
    size_hint_x: 0.8
    height: 600
    BoxLayout:
        orientation: "vertical"
        GridLayout:
            cols: 2
            rows: 5
            Label: 
                text: "PV"
                font_size: 14
            Label:
                id: CargaEsteira
                text: '-.- Kgf/cm²'
                font_size: 14
                haligh: "center"
                valign: "middle"
            
            Label:
                text: 'Status do PID'
                font_size: 14
            Label:
                id: statusPID
                text: 'Desligado'
                font_size: 14
                haligh: "center"
                valign: "middle"
        BoxLayout:
            orientation: "vertical"
            Label:
                text: "Modo de operação:"
                font_size: 14
            GridLayout:
                cols: 2
                rows:2
                CheckBox:
                    id: AutomaticoOn
                    size: 50, 10
                    group: "Aut/Man"
                    active: True        # começa em automático
                    on_active:
                        if self.active: root.setModoAutomatico()
                Label:
                    text: "Automático"

                CheckBox:
                    id: ManualOn
                    size: 50, 10
                    group: "Aut/Man"
                    active: False
                    on_active:
                        if self.active: root.setModoManual()
                Label:
                    text: "Manual"
        GridLayout:
            cols: 2
            rows:5
            Label:
                text: "Defina o Setpoint(SP):"
                font_size: 14
            TextInput:
                id: SetPoint
                font_size: 14
                text: ' '
                haligh: "center"
                valign: "middle"
                padding: 8,8,8,8
                on_text_validate: root.setSetPoint()
                multiline: False
            Label:
                text: "MV (%):"
                font_size: 14
            TextInput:
                id: VarManip
                multiline: False
                input_filter: 'float'
                text: "0.0"
                on_text_validate: root.setMV()
                on_focus:
                    if not self.focus: root.setMV()
            Label:
                text: "P:"
                font_size: 14
            TextInput:
                id: ControleP
                font_size: 14
                text: "8.0"
                haligh: "center"
                valign: "middle"
                padding: 8,8,8,8
                on_text_validate: root.setP()   
                multiline: False
            Label:
                text: "I:"
                font_size: 14
            TextInput: 
                id: ControleI
                font_size: 14
                text: "5.0"
                haligh: "center"
                valign: "middle"
                padding: 8,8,8,8
                on_text_validate: root.setI()
                multiline: False
            Label:
                text: "D:"
                font_size: 14
            TextInput:
                id: ControleD
                font_size: 14
                text: "2.0"
                haligh: "center"
                valign: "middle"
                padding: 8,8,8,8
                on_text_validate: root.setD()
                multiline: False

<MedicoesPopup>:
    title: "Medições de variáveis elétricas"
    size_hint: 0.95, 0.9

    BoxLayout:
        orientation: "vertical"
        padding: dp(18)
        spacing: dp(10)

        canvas.before:
            Color:
                rgba: 0.1, 0.7, 0.8, 1
            Rectangle:
                pos: self.x, self.top - dp(2)
                size: self.width, dp(2)

        GridLayout:
            cols: 2
            spacing: dp(40)

            # =========================
            # COLUNA ESQUERDA
            # =========================
            GridLayout:
                cols: 3
                row_default_height: dp(30)
                row_force_default: True
                spacing: dp(8)

                Label:
                    text: "Corrente Média"
                    size_hint_x: None
                    width: dp(200)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                Label:
                    id: CorrenteMedia
                    text: "-.-"
                    size_hint_x: None
                    width: dp(80)
                    halign: "right"
                    valign: "middle"
                    text_size: self.size
                Label:
                    text: "A"
                    size_hint_x: None
                    width: dp(40)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                Label:
                    text: "Tensão entre a fase S e T"
                    size_hint_x: None
                    width: dp(200)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                Label:
                    id: dppST
                    text: "-.-"
                    size_hint_x: None
                    width: dp(80)
                    halign: "right"
                    valign: "middle"
                    text_size: self.size
                Label:
                    text: "V"
                    size_hint_x: None
                    width: dp(40)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                Label:
                    text: "Frequência da rede"
                    size_hint_x: None
                    width: dp(200)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                Label:
                    id: FrequenciaRede
                    text: "-.-"
                    size_hint_x: None
                    width: dp(80)
                    halign: "right"
                    valign: "middle"
                    text_size: self.size
                Label:
                    text: "Hz"
                    size_hint_x: None
                    width: dp(40)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                Label:
                    text: "Corrente Fase S"
                    size_hint_x: None
                    width: dp(200)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                Label:
                    id: CorrenteS
                    text: "-.-"
                    size_hint_x: None
                    width: dp(80)
                    halign: "right"
                    valign: "middle"
                    text_size: self.size
                Label:
                    text: "A"
                    size_hint_x: None
                    width: dp(40)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                Label:
                    text: "Potência Ativa Total"
                    size_hint_x: None
                    width: dp(200)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                Label:
                    id: PotAtivaTotal
                    text: "-.-"
                    size_hint_x: None
                    width: dp(80)
                    halign: "right"
                    valign: "middle"
                    text_size: self.size
                Label:
                    text: "W"
                    size_hint_x: None
                    width: dp(40)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                Label:
                    text: "Potência Reativa Total"
                    size_hint_x: None
                    width: dp(200)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                Label:
                    id: PotReativaTotal
                    text: "-.-"
                    size_hint_x: None
                    width: dp(80)
                    halign: "right"
                    valign: "middle"
                    text_size: self.size
                Label:
                    text: "W"
                    size_hint_x: None
                    width: dp(40)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                Label:
                    text: "THD da Corrente da fase R"
                    size_hint_x: None
                    width: dp(200)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                Label:
                    id: THDCorrenteR
                    text: "-.-"
                    size_hint_x: None
                    width: dp(80)
                    halign: "right"
                    valign: "middle"
                    text_size: self.size
                Label:
                    text: "%"
                    size_hint_x: None
                    width: dp(40)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                Label:
                    text: "THD da Corrente da fase T"
                    size_hint_x: None
                    width: dp(200)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                Label:
                    id: THDCorrenteT
                    text: "-.-"
                    size_hint_x: None
                    width: dp(80)
                    halign: "right"
                    valign: "middle"
                    text_size: self.size
                Label:
                    text: "%"
                    size_hint_x: None
                    width: dp(40)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

            # =========================
            # COLUNA DIREITA
            # =========================
            GridLayout:
                cols: 3
                row_default_height: dp(30)
                row_force_default: True
                spacing: dp(8)

                Label:
                    text: "Tensão entre a fase R e S"
                    size_hint_x: None
                    width: dp(200)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
