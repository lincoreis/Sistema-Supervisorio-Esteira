                    width: dp(80)
                    halign: "right"
                    valign: "middle"
                    text_size: self.size
                Label:
                    text: "V"
                    size_hint_x: None
                    width: dp(40)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                Label:
                    text: "Tensão entre a fase T e R"
                    size_hint_x: None
                    width: dp(200)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                Label:
                    id: dppTR
                    text: "-.-"
                    size_hint_x: None
                    width: dp(80)
                    halign: "right"
                    valign: "middle"
                    text_size: self.size
                Label:
                    text: "V"
                    size_hint_x: None
                    width: dp(40)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                Label:
                    text: "Corrente Fase R"
                    size_hint_x: None
                    width: dp(200)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                Label:
                    id: CorrenteR
                    text: "-.-"
                    size_hint_x: None
                    width: dp(80)
                    halign: "right"
                    valign: "middle"
                    text_size: self.size
                Label:
                    text: "A"
                    size_hint_x: None
                    width: dp(40)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                Label:
                    text: "Corrente Fase T"
                    size_hint_x: None
                    width: dp(200)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                Label:
                    id: CorrenteT
                    text: "-.-"
                    size_hint_x: None
                    width: dp(80)
                    halign: "right"
                    valign: "middle"
                    text_size: self.size
                Label:
                    text: "A"
                    size_hint_x: None
                    width: dp(40)
                    halign: "left"
