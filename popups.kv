            Label:
                text: "ºC"
                size_hint_x: None
                width: dp(40)
                halign: "left"
                valign: "middle"
                text_size: self.size

<ComandoPopup>:
    title:"Comandos do motor"
    separator_color: 0, 0, 0, 1
    size_hint_y: None
    size_hint_x: 0.95
    height: 350
    GridLayout:
        cols:3
        spacing: 10
        canvas.before:
            Color:
                rgba: 0.9, 0.9, 0.9, 1
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            orientation: "vertical"
            size_hint_x: 0.3
        
            spacing:10
            canvas.before:
                Color:
                    rgba: 0.8, 0.8, 0.8, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "Comandos na esteira"
                font_size: 14
                color: 0, 0, 0, 1  # Cor preta

            Button:
                background_color: 0.5, 0.5, 0.5, 0.5
                background_normal: ''
               
                text: "Ligar"
                padding: 8,8,8,8
                height: 100
                on_release: root.setOperacao(1)
              
            Button:
                background_color: 0.5, 0.5, 0.5, 0.5
                background_normal: ''
               
                text: "Desligar"
                
                padding: 8,8,8,8
                height: 100
                on_release: root.setOperacao(0)
 
            Button:
                background_color: 0.5, 0.5, 0.5, 0.5
                background_normal: ''
                text: "Reset"
                padding: 8,8,8,8
                height: 100
                on_release: root.setOperacao(2)
           
        BoxLayout:
            orientation: "vertical"
            spacing:10
            size_hint_x: 0.3
            size_hint_y: 0.98
            canvas.before:
                Color:
                    rgba: 0.8, 0.8, 0.8, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label: 
                text: "Tipo de partida"
                font_size: 14
                color: 0, 0, 0, 1  # Cor preta
            Button:
                background_color: 0.5, 0.5, 0.5, 1  # Cinza
        
                text: "Partida Direta"
                height: 100
                on_release: root.setPartida('Direta')
      
            Button:
                background_color: 0.5, 0.5, 0.5, 1  # Cinza
                text: "Partida pelo Inversor"
                height: 100
                on_release: root.setPartida('Inversor')
         
            Button:
                background_color: 0.5, 0.5, 0.5, 1  # Cinza
                text: "Partida Soft-Start"
                height: 100
                on_release: root.setPartida('Soft-Start')
        BoxLayout:
            orientation: "vertical"
            spacing:10
            size_hint_x: 0.3
            size_hint_y: 0.98
            canvas.before:
                Color:
                    rgba: 0.8, 0.8, 0.8, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            BoxLayout:
                orientation: "horizontal"
                size_hint_X:0.75
                BoxLayout:
                    orientation: "vertical"
                    Label:
                        text:"Inversor"
                        color: 0, 0, 0, 1  # Cor preta

                    GridLayout:
                        cols:2
                        rows:2
                        Label:
                            text: "Acel.(s)"
                            color: 0, 0, 0, 1  # Cor preta

                        TextInput:
                            id: RampaAcelInv
                            font_size: 14
                            text: "10"
                            haligh: "center"
                            valign: "middle"
                            padding: 8,8,8,8
                            on_text_validate: root.setAcc()
                            multiline: False
                            background_color: 0.9, 0.9, 0.9, 1  # Cor cinza claro
                            foreground_color: 0, 0, 0, 1  # Texto preto

                        Label:
                            text: "Desacel.(s)"
                            color: 0, 0, 0, 1  # Cor preta

                        TextInput:
                            id: RampaDesacelInv
                            font_size: 14
                            text: "10"
                            haligh: "center"
                            valign: "middle"
                            padding: 8,8,8,8
                            background_color: 0.9, 0.9, 0.9, 1  # Cor cinza claro
                            foreground_color: 0, 0, 0, 1  # Texto preto
                            on_text_validate: root.setDcc()
                            multiline: False
                    BoxLayout:
                        orientation: "vertical"
                        Label:
                            haligh: "center"
                            text:"      Min: 10s Max: 60s"
                            color: 0, 0, 0, 1  # Cor preta

                    BoxLayout:
                        orientation: "vertical"
                        Label:
                            text:"Velocidade(0 a 60Hz)"
                            color: 0, 0, 0, 1  # Cor preta
                            bold: True
                        TextInput:
                            id: VelInv
                            font_size: 14
                            text: "60"
                            haligh: "center"
                            valign: "middle"
                            padding: 8,8,8,8
                            on_text_validate: root.setVelInversor()
                            background_color: 0.9, 0.9, 0.9, 1  # Cor cinza claro
                            foreground_color: 0, 0, 0, 1  # Texto preto
                            multiline: False

<SelectDataGraphPopup>:
    title: "Seleção de grandeza"
    size_hint: (0.8,1)
    BoxLayout:
        orientation: 'vertical'
        GridLayout:
            cols: 4
            rows: 11
            id: sensores
            CheckBox:
                id:checkVelocidadeEsteira
                group: 'select_group'
                on_active: app.root.updateSelectedGrandeza('VelocidadeEsteira') if app.root is not None else None
            Label:
                text: "Velocidade da Esteira (m/min)"
            CheckBox:
                id:checktorque
                group: 'select_group'
                on_active: app.root.updateSelectedGrandeza('torque') if app.root is not None else None
            Label:
                text: "Torque (N.m)"
            CheckBox:
                id:checkFrequenciaRotacao
                group: 'select_group'
                on_active: app.root.updateSelectedGrandeza('FrequenciaRotacao') if app.root is not None else None
            Label:
                text: "Frequencia de Rotação (RPM)"
            CheckBox:
                id:checkCargaEsteira
                group: 'select_group'
                on_active: app.root.updateSelectedGrandeza('CargaEsteira') if app.root is not None else None
            Label:
                text: "Carga (Kgf/cm²)"
            CheckBox:
                id:checkTempCarc
                group: 'select_group'
                on_active: app.root.updateSelectedGrandeza('TempCarc') if app.root is not None else None
            Label:
                text: "Temperatura da Carcaça (ºC)"
            CheckBox:
                id:checkCorrenteMedia
